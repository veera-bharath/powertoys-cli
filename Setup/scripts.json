{
    "installPath":  "C:\\Tools\\PowerToys",
    "repoRoot":  "D:\\Projects\\PowerToys",
    "scripts":  [
                    {
                        "id":  "FileOrganizer",
                        "displayName":  "FileOrganizer",
                        "description":  "Organize files into folders by extension",
                        "source":  "FileOrganizer/FileOrganizer.ps1",
                        "usage":  "FileOrganizer [path] [-WhatIf]"
                    },
                    {
                        "id":  "FileOrganizerAI",
                        "displayName":  "FileOrganizerAI (experimental)",
                        "description":  "AI-enhanced organizer using Ollama as fallback",
                        "source":  "FileOrganizerAI/FileOrganizerAI.ps1",
                        "usage":  "FileOrganizerAI [-Source path] [-UseAI] [-Model gemma:2b] [-DryRun]"
                    },
                    {
                        "id":  "DiskCleaner",
                        "displayName":  "DiskCleaner",
                        "description":  "Analyze disk usage by type, find duplicates and large files, delete or organize",
                        "source":  "DiskCleaner/DiskCleaner.ps1",
                        "usage":  "DiskCleaner [-Path <path>]"
                    },
                    {
                        "id":  "AppUninstaller",
                        "displayName":  "AppUninstaller",
                        "description":  "List installed apps with details and uninstall interactively",
                        "source":  "AppUninstaller/AppUninstaller.ps1",
                        "usage":  "AppUninstaller [-IncludeStore]"
                    },
                    {
                        "id":  "port",
                        "displayName":  "PortManager",
                        "description":  "Inspect, kill, list, watch, and find free ports",
                        "source":  "PortManager/PortManager.ps1",
                        "usage":  "port --get <port> | --kill <port> | --list | --watch <port> | --free"
                    }
                ]
}
